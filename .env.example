# Salin ke .env (atau isi di unit systemd) lalu sesuaikan.
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
# Alamat publik web, dipakai untuk tautan email dan masuk dengan Google.
PUBLIC_URL=https://iup.example.com
DB_PATH=/var/lib/iup/iup.db
# Email verifikasi dan atur ulang sandi (Resend). Kosongkan untuk mencetak email ke log.
RESEND_API_KEY=
MAIL_FROM="Web Persiapan IUP <no-reply@iup.example.com>"
# Masuk dengan Google (opsional). Redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
