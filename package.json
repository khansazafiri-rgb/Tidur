{
  "name": "tidur-iup",
  "version": "0.1.0",
  "private": true,
  "description": "Web latihan soal dan try out gratis untuk tes masuk kedokteran jalur IUP (UNAIR, UGM, UI)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "import": "node --disable-warning=ExperimentalWarning scripts/import-folder.js",
    "fetch-drive": "node scripts/fetch-drive.js",
    "make-admin": "node --disable-warning=ExperimentalWarning scripts/make-admin.js",
    "calibrate": "node --disable-warning=ExperimentalWarning scripts/calibrate.js",
    "test": "node --disable-warning=ExperimentalWarning --test server/tests/*.test.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@fontsource/baloo-2": "^5.1.0",
    "@fontsource/nunito-sans": "^5.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "dompurify": "^3.2.3",
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "marked": "^14.1.4",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
